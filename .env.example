# QQ 机器人账号和唯一启用的测试群
QQ_UIN=123456789
NAO_TEST_GROUP_ID=123456789

# Lagrange 签名服务令牌（不是 Milky Token）
LAGRANGE_SIGNER_TOKEN=replace-with-your-lagrange-signer-token

# Lagrange.Milky 与 NoneBot 必须使用同一个随机 Token
MILKY_ACCESS_TOKEN=replace-with-a-long-random-token

# DeepSeek 官方 API
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# 留空时使用 QQ 群主/管理员身份；填写后仅允许这些 QQ 号
NAO_ADMIN_QQ_IDS=
